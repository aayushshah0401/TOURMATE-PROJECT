rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All Access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isVerifiedBusiness() {
      return hasRole('business') && request.auth.token.verified == true;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminFlags']);
      allow delete: if isAdmin();
    }

    // 2. Private User Trip Plans (User Data Isolation)
    match /trips/{tripId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Public Destinations & Attractions (Read for all, Write for Admin)
    match /destinations/{destId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attractions/{attrId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Business Listings (Hotels & Restaurants)
    match /businessListings/{listingId} {
      allow read: if true; // Public discovery
      allow create: if isVerifiedBusiness();
      allow update, delete: if isVerifiedBusiness() && resource.data.ownerUid == request.auth.uid || isAdmin();
    }

    // 5. Smart Kiosks Fleet Control (Restricted Device Identity & Admin)
    match /kiosks/{kioskId} {
      allow read: if true;
      allow update: if isAuthenticated() && (hasRole('kiosk') || isAdmin());
      allow create, delete: if isAdmin();
    }

    // 6. Security Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
